    name = "format_maven",
    artifacts = [
        "org.scalameta:scalafmt-cli_2.13:3.11.5",
    ],
    lock_file = "//:format_maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
